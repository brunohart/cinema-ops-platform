# Copy to .env and fill in. Every value here is blank on purpose (VDE-51).
# .env is gitignored (.env, .env.* with !.env.example) and is never committed.
# Local-stack values — host, ports, the compose role names — live in
# docker-compose.yml and in the code defaults (ADR-010), deliberately not here.
# CI reads the secret-class keys from GitHub repo secrets:
# docs/2026-08-01-vde-51-secrets-out.md names which, and who sets them.

# --- secret class: third-party credentials, never in git ------------------
TMDB_API_KEY=
SLACK_WEBHOOK_URL=
LINEAR_API_KEY=

# --- local Postgres DSNs (ADR-010; agent role holds no PII grant, ADR-009)
DB=
DATABASE_URL=
AGENT_DATABASE_URL=
CINEMA_TEST_DATABASE_URL=

# --- dbt profile (dbt/profiles.yml, transform/profiles.yml) ---------------
DBT_HOST=
DBT_PORT=
DBT_USER=
DBT_PASSWORD=
DBT_DBNAME=

# --- Redpanda (ADR-007) --------------------------------------------------
KAFKA_BOOTSTRAP=
KAFKA_TOPIC=
KAFKA_GROUP_ID=

# --- agent tool surface (VDE-44; an empty token refuses to serve) --------
AGENT_TOOL_TOKEN=
AGENT_TOOLS_HOST=
AGENT_TOOLS_PORT=
AGENT_TOOLS_VERBOSE=

# --- Dagster run links in alerts (VDE-35; DAGIT_ is the legacy alias) ----
DAGSTER_UI_BASE_URL=
DAGIT_BASE_URL=
