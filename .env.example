# Copy to .env and fill in. Never commit .env.
# All variables are optional — compose uses the defaults shown in parentheses.
TMDB_API_KEY=
# DB=postgresql://cinema:cinema@localhost:5432/cinema_ops
# DATABASE_URL=postgresql://cinema:cinema@localhost:5432/cinema_ops

# Agent tool layer (ADR-009) — role holds no grant on dim_customer PII.
# AGENT_DATABASE_URL=postgresql://agent_reader:agent_reader@localhost:5432/cinema_ops

# Redpanda (docker-compose service advertises localhost:19092 by default)
# KAFKA_BOOTSTRAP=localhost:19092
# KAFKA_TOPIC=ticketing.bookings
# KAFKA_GROUP_ID=cinema-ops-events

# VDE-35 — Slack Incoming Webhook (secret; never commit the real URL)
# Slack → Apps → Incoming Webhooks → add to a private test channel
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# DAGSTER_UI_BASE_URL=http://localhost:3000

# VDE-44 — tools HTTP surface on :8787; bearer token required
# AGENT_TOOL_TOKEN=dev-token-change-me
# AGENT_TOOLS_PORT=8787

# VDE-49 — port knobs (defaults shown); override to avoid conflicts.
# DB_HOST_PORT=5432
# RP_KAFKA_PORT=19092
# RP_PROXY_PORT=18082
# RP_SCHEMA_PORT=18081
# RP_ADMIN_PORT=19644
# DAGSTER_PORT=3000
# AGENT_READER_PASSWORD=agent_reader
