{
  "name": "cinema-ops-agent-api",
  "version": "0.1.0",
  "private": true,
  "description": "Allowlisted agent read path + Hono HTTP surface over gold (VDE-38 / VDE-39 / VDE-42 / ADR-009)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./queries": "./dist/queries.js",
    "./schemas": "./src/schemas.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "prove": "bash ../scripts/prove_allowlisted_queries.sh",
    "prove-pii-absent": "bash ../scripts/prove_pii_absent.sh",
    "prove-http": "bash ../scripts/prove-agent-api.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "hono": "^4.8.5",
    "postgres": "^3.4.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
