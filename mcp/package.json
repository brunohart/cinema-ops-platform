{
  "name": "cinema-ops-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bounded MCP tool surface over gold — the subject of evals/mcp.yaml (VDE-47 / VDE-40)",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && esbuild src/mcp.ts --bundle --platform=node --format=esm --outfile=../dist/mcp.js --packages=bundle",
    "build:tsc": "tsc -p tsconfig.json",
    "start": "node ../dist/mcp.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  }
}
